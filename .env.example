# ════════════════════════════════════════════════════════════════════════════════
# MadeByTK Toto Engine — environment variable reference
#
# Copy into two files:
#   .env.config   — non-sensitive config (safe to commit to git)
#   .env.secret   — credentials and keys  (NEVER commit — gitignored)
#
# Both files are loaded automatically at startup (secrets override config on
# any variable that appears in both).
# ════════════════════════════════════════════════════════════════════════════════


# ── .env.secret — CREDENTIALS (never commit) ────────────────────────────────

# Anthropic Claude (for bet slip OCR)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (anon key for public reads, or service_role for full access)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── .env.config — NON-SENSITIVE CONFIG (safe to commit) ─────────────────────

# App behaviour
ENVIRONMENT=development
TZ=Asia/Singapore
# Optional. Browser origins FastAPI itself answers CORS for. Leave unset on the VM (nginx is
# same-origin) and on Azure Functions (the platform CORS setting handles it, and setting both
# sends duplicate headers).
# CORS_ORIGINS=https://madebytk.com

# Scheduler (APScheduler, all times in TZ above)
# SCHEDULER_ENABLED=true   # set false on Azure Functions (timer triggers run the jobs)
PREDICT_HOUR=8
PREDICT_MINUTE=0
RESULTS_HOUR=19
RESULTS_MINUTE=0
# Results job runs hourly from RESULTS_HOUR to this hour (SGT); the last run fails loudly.
RESULTS_RETRY_UNTIL_HOUR=22
PREDICT_DAYS=mon,thu
RESULTS_DAYS=*
# Fallback only — real next-draw date comes from TOTO_NEXT_DRAW_URL live.
# Used if that fetch fails: expected_date=actual_date,... (leave blank normally).
DRAW_DATE_OVERRIDES=

# Scraper
SCRAPER_TIMEOUT=20
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; TotoEngine/3.0)

# Data Sources
SINGAPORE_POOLS_URL=https://www.singaporepools.com.sg/en/product/sr/Pages/toto_results.aspx
LOTTOLYZER_URL=https://en.lottolyzer.com/history/singapore/toto
LOTTERY_EXTREME_URL=https://www.lotteryextreme.com/singapore/toto-results
LOTTERY_EXTREME_WINNERS_URL=https://www.lotteryextreme.com/singapore/toto-winners
SG_LOTTO_RESULT_URL=https://sglottoresult.com/toto
TOTO_NEXT_DRAW_URL=https://www.singaporepools.com.sg/DataFileArchive/Lottery/Output/toto_next_draw_estimate_en.html

# Claude AI
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024
